# ─────────────────────────────────────────────────────────────
#  .env.example — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the actual .env file to Git!
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=root
DB_PASS=

# ── Site Settings ─────────────────────────────────────────────
APP_NAME="বাংলা শপ"
APP_URL=http://localhost:8080
APP_ENV=local

# ── Upload Settings ───────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads/

# ── Payment Gateways ──────────────────────────────────────────
BKASH_API_KEY=
BKASH_SECRET=
NAGAD_API_KEY=
NAGAD_SECRET=

# ── Meta / Facebook Pixel ─────────────────────────────────────
META_PIXEL_ID=
GTM_CONTAINER_ID=

# ── Email / SMTP ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@email.com
MAIL_PASS=
MAIL_FROM_NAME="বাংলা শপ"
